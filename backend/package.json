{
  "name": "mltrack-backend",
  "version": "1.0.0",
  "description": "Backend para el sistema de tracking de productos de MercadoLibre",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "pm2:start": "pm2 start pm2.config.js",
    "pm2:stop": "pm2 stop mltrack-backend",
    "pm2:restart": "pm2 restart mltrack-backend",
    "pm2:logs": "pm2 logs mltrack-backend"
  },
  "keywords": ["mercadolibre", "tracking", "products", "oauth2", "fastify"],
  "author": "MLTrack Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/env": "^4.2.0",
    "@fastify/jwt": "^7.2.4",
    "@fastify/redis": "^6.1.1",
    "axios": "^1.6.0",
    "bullmq": "^4.15.0",
    "drizzle-orm": "^0.29.0",
    "fastify": "^4.24.3",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "socket.io": "^4.7.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.7",
    "drizzle-kit": "^0.20.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
